{
  "name": "magic-vault-monorepo",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "version:patch": "node scripts/version-bump.mjs patch",
    "version:minor": "node scripts/version-bump.mjs minor",
    "version:major": "node scripts/version-bump.mjs major"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  },
  "packageManager": "pnpm@9.1.3",
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.6.1",
      "tar": ">=7.5.19",
      "sharp": ">=0.35.3",
      "kysely": ">=0.28.17"
    }
  }
}
