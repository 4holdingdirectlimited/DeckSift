WEB_URL=http://localhost:5173
PORT=3001

# Local PostgreSQL (see packages/server/sql/local-bootstrap.sql)
DATABASE_URL=postgres://postgres@127.0.0.1:5433/mault

# Public variables for the React app
VITE_API_URL=http://localhost:3001
VITE_APP_ENV=local

# Vision embedding backend: cpu (q8) or dml (DirectML GPU — ~1.9x faster on
# this machine). q8 is forced to fp32 automatically when dml is selected.
VECTORIZE_DEVICE=cpu

# Optional: override where the server keeps its local caches.
# Defaults to <repo>/packages/server/.cache/{sync,art}
# SYNC_CACHE_DIR=C:\Mault Revised\.local\cache\sync
# ART_CACHE_DIR=C:\Mault Revised\.local\cache\art

# Sync pacing (defaults shown). The sync backs off to SYNC_PACE_SCAN_MS per
# batch for 5s after any scan so the desktop compositor and scan embeds stay
# responsive; SYNC_PACE_IDLE_MS is the near-zero cost beat when idle.
# SYNC_FETCH_BATCH=16
# SYNC_EMBED_BATCH=8
# SYNC_PACE_SCAN_MS=200
# SYNC_PACE_IDLE_MS=10
