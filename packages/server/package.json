{
  "name": "@magic-vault/server",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:prune-images": "tsx src/lib/prune-images.ts",
    "bench:vectorize": "tsx scripts/bench-vectorize.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@huggingface/transformers": "^3.8.1",
    "@magic-vault/shared": "workspace:*",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.4",
    "jose": "^6.1.3",
    "pg": "^8.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
